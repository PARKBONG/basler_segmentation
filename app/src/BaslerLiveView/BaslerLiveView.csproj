<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Basler.Pylon.dll is x64-only; force an x64 process so the native pylon libs load. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <AssemblyName>BaslerLiveView</AssemblyName>
    <RootNamespace>BaslerLiveView</RootNamespace>
  </PropertyGroup>

  <!-- Managed wrapper assembly shipped with the SDK checkout. -->
  <ItemGroup>
    <Reference Include="Basler.Pylon">
      <HintPath>..\..\external\pylon\Development\Assemblies\Basler.Pylon\net8.0\x64\Basler.Pylon.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!--
    YoloDotNet (built from source under external\YoloDotNet). The core library plus
    exactly ONE execution provider — DirectML for vendor-neutral GPU acceleration on
    Windows (DX12). To switch to NVIDIA CUDA/TensorRT later, replace the DirectML
    ProjectReference below with the Cuda one and install the CUDA 12.x + cuDNN 9.x
    runtime. Only one execution provider may be referenced per project.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\external\YoloDotNet\YoloDotNet\YoloDotNet.csproj" />
    <ProjectReference Include="..\..\external\YoloDotNet\YoloDotNet.ExecutionProvider.DirectML\YoloDotNet.ExecutionProvider.DirectML.csproj" />
  </ItemGroup>

  <!--
    ONNX models (segmentation or OBB) come from the repo-root weights\ folder: archived
    training runs, tracked with Git LFS. weights\deploy.yaml picks one run per app model
    name, one "name: <name>/<stamp>" per line, e.g.

        yolo26s-seg.onnx: yolo26s-seg-all/261022_151611

    and this target copies weights\<run>\weights\best.onnx to $(OutDir)Models\<name>,
    where the app looks up config.xml <Inference><Model>. Deploying = edit that file,
    commit, rebuild. A fresh clone needs `git lfs pull` first (otherwise best.onnx is a
    small LFS pointer and the model fails to load).
  -->
  <PropertyGroup>
    <WeightsDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\weights'))\</WeightsDir>
    <DeployList>$(WeightsDir)deploy.yaml</DeployList>
  </PropertyGroup>

  <ItemGroup>
    <!-- Rebuild (VS fast up-to-date check) when the deployment choice changes. -->
    <UpToDateCheckInput Include="$(DeployList)" />
  </ItemGroup>

  <Target Name="DeployModels" AfterTargets="Build">
    <Error Condition="!Exists('$(DeployList)')" Text="Model list missing: $(DeployList)" />
    <ReadLinesFromFile File="$(DeployList)">
      <Output TaskParameter="Lines" ItemName="_DeployLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_DeployLine Remove="@(_DeployLine)" Condition="$([System.String]::Copy('%(Identity)').TrimStart().StartsWith('#'))" />
      <_DeployEntry Include="@(_DeployLine)">
        <ModelName>$([System.String]::Copy('%(Identity)').Split(':')[0].Trim())</ModelName>
        <Run>$([System.String]::Copy('%(Identity)').Split(':')[1].Split('#')[0].Trim())</Run>
      </_DeployEntry>
      <_DeployModel Include="@(_DeployEntry->'$(WeightsDir)%(Run)\weights\best.onnx')" />
    </ItemGroup>
    <Error Condition="!Exists('%(_DeployModel.Identity)')"
           Text="weights\deploy.yaml: %(_DeployModel.ModelName) → %(_DeployModel.Identity) not found (archive the run with training/archive.py, or `git lfs pull`)." />
    <Copy SourceFiles="@(_DeployModel)" DestinationFiles="@(_DeployModel->'$(OutDir)Models\%(ModelName)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Model %(_DeployModel.ModelName) ← %(_DeployModel.Identity)" />
  </Target>

  <!--
    pylon is NOT installed system-wide on this machine, so the native runtime
    (PylonBase / PylonC / transport-layer *_TL.dll producers) must sit next to
    the executable. Copy the whole Runtime\x64 tree into the output folder;
    the app base directory is always on the native DLL search path.
  -->
  <PropertyGroup>
    <PylonRuntimeDir>$(MSBuildThisFileDirectory)..\..\external\pylon\Runtime\x64</PylonRuntimeDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(PylonRuntimeDir)\**\*.*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <!-- Ship config\config.xml next to the exe (camera settings, loaded at Open). -->
  <ItemGroup>
    <None Update="config\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
