<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Basler.Pylon.dll is x64-only; force an x64 process so the native pylon libs load. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <AssemblyName>BaslerLiveView</AssemblyName>
    <RootNamespace>BaslerLiveView</RootNamespace>
  </PropertyGroup>

  <!-- Managed wrapper assembly shipped with the SDK checkout. -->
  <ItemGroup>
    <Reference Include="Basler.Pylon">
      <HintPath>..\..\external\pylon\Development\Assemblies\Basler.Pylon\net8.0\x64\Basler.Pylon.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!--
    YoloDotNet (built from source under external\YoloDotNet). The core library plus
    exactly ONE execution provider — DirectML for vendor-neutral GPU acceleration on
    Windows (DX12). To switch to NVIDIA CUDA/TensorRT later, replace the DirectML
    ProjectReference below with the Cuda one and install the CUDA 12.x + cuDNN 9.x
    runtime. Only one execution provider may be referenced per project.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\external\YoloDotNet\YoloDotNet\YoloDotNet.csproj" />
    <ProjectReference Include="..\..\external\YoloDotNet\YoloDotNet.ExecutionProvider.DirectML\YoloDotNet.ExecutionProvider.DirectML.csproj" />
  </ItemGroup>

  <!--
    ONNX models (segmentation or OBB). Not committed to this repo (large binary) and
    not bundled by the YoloDotNet submodule: training's export (deploy_to) writes them
    into src\BaslerLiveView\Models\, or drop yolo26s-seg.onnx there yourself.
    Any *.onnx under Models\ is copied next to the executable on build — except
    Models\history\ (timestamped earlier deployments, kept only for rollback).
  -->
  <ItemGroup>
    <None Include="Models\**\*.onnx" Exclude="Models\history\**">
      <Link>Models\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CheckSegModel" AfterTargets="Build">
    <PropertyGroup>
      <SegModelDest>$(OutDir)Models\yolo26s-seg.onnx</SegModelDest>
    </PropertyGroup>
    <Warning Text="Default model missing: place yolo26s-seg.onnx in src\BaslerLiveView\Models\ (training's train.seg_all.yaml export deploys it there) — it is not bundled by the YoloDotNet submodule."
             Condition="!Exists('$(SegModelDest)')" />
  </Target>

  <!--
    pylon is NOT installed system-wide on this machine, so the native runtime
    (PylonBase / PylonC / transport-layer *_TL.dll producers) must sit next to
    the executable. Copy the whole Runtime\x64 tree into the output folder;
    the app base directory is always on the native DLL search path.
  -->
  <PropertyGroup>
    <PylonRuntimeDir>$(MSBuildThisFileDirectory)..\..\external\pylon\Runtime\x64</PylonRuntimeDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(PylonRuntimeDir)\**\*.*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <!-- Ship config\config.xml next to the exe (camera settings, loaded at Open). -->
  <ItemGroup>
    <None Update="config\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
