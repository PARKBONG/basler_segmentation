# ----------------------------------------------------------------------------
# Basler Pylon SDK (vendored under include/pylon/)
# Keep ONLY the minimal set BaslerLiveView needs to build + run (USB3 / GigE):
#   - Development/Assemblies/Basler.Pylon  (managed reference, compile-time)
#   - Runtime/x64/*                        (native core + USB/GigE transport)
# Everything below is large and unused by the app, so it stays out of git
# (it remains on disk locally for anyone who needs it).
# ----------------------------------------------------------------------------
include/pylon/Applications/
include/pylon/Documentation/
include/pylon/Development/Samples/
include/pylon/Runtime/Win32/
include/pylon/Runtime/CLProtocol/
include/pylon/Runtime/x64/pylonCXP/
include/pylon/Runtime/x64/pylonDataProcessingPlugins/
include/pylon/Runtime/x64/DataProcessingPluginsB/

# NOTE: include/YoloDotNet is a git submodule (see .gitmodules) — do NOT ignore it.

# ONNX models — not committed; the default is auto-copied from the YoloDotNet
# submodule's assets at build time (see BaslerLiveView.csproj).
*.onnx
