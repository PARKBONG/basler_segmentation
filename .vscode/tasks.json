{
  // training 학습·추론 — Ctrl+Shift+P → "Tasks: Run Task".
  // 모두 training/ 에서 uv 로 실행 (경로 입력은 training/ 기준 또는 절대경로).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "training: train",
      "detail": "configs/train.*.yaml 하나를 골라 학습 (+ export)",
      "type": "process",
      "command": "uv",
      "args": ["run", "--extra", "train", "--extra", "export", "train.py", "--config", "${input:trainConfig}"],
      "options": { "cwd": "${workspaceFolder}/training" },
      "problemMatcher": []
    },
    {
      "label": "training: inference — 사진 1장",
      "detail": "크롭 → 예측 그림 (runs/infer/<시각>/<이름>_pred.jpg)",
      "type": "process",
      "command": "uv",
      "args": ["run", "--extra", "train", "--extra", "export", "infer.py",
               "--weights", "${input:weights}", "--source", "${input:image}", "--crop", "${input:crop}"],
      "options": { "cwd": "${workspaceFolder}/training" },
      "problemMatcher": []
    },
    {
      "label": "training: inference — 세션 → 동영상",
      "detail": "세션 폴더의 전 프레임 → 동영상 (runs/infer/<시각>/<세션>.mp4)",
      "type": "process",
      "command": "uv",
      "args": ["run", "--extra", "train", "--extra", "export", "infer.py",
               "--weights", "${input:weights}", "--source", "${input:session}",
               "--crop", "${input:crop}", "--fps", "${input:fps}"],
      "options": { "cwd": "${workspaceFolder}/training" },
      "problemMatcher": []
    },
    {
      "label": "training: tensorboard",
      "detail": "http://localhost:6006 — runs/ 아래 모든 학습 (멈출 땐 터미널 휴지통)",
      "type": "process",
      "command": "uv",
      "args": ["run", "--extra", "train", "tensorboard", "--logdir", "runs", "--host", "127.0.0.1", "--port", "6006"],
      "options": { "cwd": "${workspaceFolder}/training" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "trainConfig",
      "type": "pickString",
      "description": "학습 config",
      "options": [
        { "label": "train.single.yaml — seg, val/test 분리 (측정용, early stop)", "value": "train.single.yaml" },
        { "label": "train.seg_all.yaml — seg, 전체 데이터 (배포용)", "value": "train.seg_all.yaml" },
        { "label": "train.obb_all.yaml — obb, 전체 데이터 (배포용, preprocess --task obb 선행)", "value": "train.obb_all.yaml" }
      ],
      "default": "train.single.yaml"
    },
    // 아래 파일 목록 드롭다운은 확장 "Command Variable"(rioj7.command-variable) 이 필요 —
    // .vscode/extensions.json 추천 목록에 있음. 목록은 실행할 때마다 디스크에서 새로 찾는다.
    {
      "id": "weights",
      "type": "command",
      "command": "extension.commandvariable.file.pickFile",
      "args": {
        "description": "가중치 (runs/<task>/<name>/<시각>/weights/*.pt) — 입력해서 거르기",
        "include": "training/runs/**/weights/*.pt",
        "display": "transform",
        "valueTransform": { "text": "${file}" },
        "labelTransform": {
          "text": "${relativeFile}",
          "apply": [
            { "find": "\\\\", "replace": "/", "flags": "g" },
            { "find": "^training/runs/", "replace": "" }
          ]
        },
        "keyRemember": "weights"
      }
    },
    {
      "id": "image",
      "type": "command",
      "command": "extension.commandvariable.file.pickFile",
      "args": {
        "description": "사진 (datasets/raw/kimm_*/images) — 파일명 일부(예: 161818 000270)를 입력해서 거르기",
        "include": "datasets/raw/kimm_*/images/*.{png,jpg,bmp}",
        "display": "fileName",
        "keyRemember": "image"
      }
    },
    {
      "id": "session",
      "type": "command",
      "command": "extension.commandvariable.file.pickFile",
      "args": {
        "description": "세션 폴더 (datasets/raw/kimm_*)",
        "include": "datasets/raw/kimm_*/data.yaml",
        "display": "transform",
        "valueTransform": { "text": "${fileDirname}" },
        "labelTransform": { "text": "${fileDirname}", "find": "^.*[\\\\/]", "replace": "" },
        "keyRemember": "session"
      }
    },
    {
      "id": "crop",
      "type": "pickString",
      "description": "크롭 'W H CX% CY%'",
      "options": [
        { "label": "auto — preprocess.yaml 값 (학습과 같은 크롭)", "value": "auto" },
        { "label": "1280 1280 40 40 — 앱 config.xml 크롭 위치", "value": "1280 1280 40 40" },
        { "label": "1280 1280 50 50 — 정중앙", "value": "1280 1280 50 50" },
        { "label": "none — 크롭 안 함 (원본 전체)", "value": "none" }
      ],
      "default": "auto"
    },
    {
      "id": "fps",
      "type": "pickString",
      "description": "동영상 fps",
      "options": ["5", "10", "15", "30"],
      "default": "5"
    }
  ]
}
