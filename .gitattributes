# 줄바꿈 규칙 — 저장소에는 LF 로 저장하고, 작업 트리는 OS 기본(core.autocrlf)을 따른다.
* text=auto

# Visual Studio / MSBuild 계열은 작업 트리에서도 항상 CRLF (VS 가 CRLF 를 기대)
*.sln       text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.cs        text eol=crlf
*.xaml      text eol=crlf
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 셸 스크립트는 항상 LF
*.sh        text eol=lf

# 바이너리 — 줄바꿈 변환·diff 대상 아님
*.png       binary
*.jpg       binary
*.jpeg      binary
*.dll       binary
*.exe       binary
*.onnx      binary
*.pt        binary
*.zip       binary

# 보관 가중치 (root weights/) — Git LFS. 커밋에는 포인터만, 파일은 LFS 저장소로
weights/**/*.pt    filter=lfs diff=lfs merge=lfs -text
weights/**/*.onnx  filter=lfs diff=lfs merge=lfs -text
