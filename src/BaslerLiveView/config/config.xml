<?xml version="1.0" encoding="utf-8"?>
<!--
  BaslerLiveView 카메라 설정.
  이 파일은 빌드 시 실행 파일 옆 config\config.xml 로 복사됩니다.
  값을 바꾼 뒤 앱을 다시 Connect 하면 반영됩니다(파일이 없거나 값이 비면 기본값 사용).
-->
<Config>
  <Camera>
    <!-- 목표 프레임레이트(fps). 카메라 AcquisitionFrameRate 로 고정합니다.
         이 fps가 실제로 나오도록 노출 시간(ExposureTime)도 프레임 주기(1/FrameRate)
         안에 들어가게 앱이 자동으로 맞춥니다. 값을 낮추면 노출 여유가 생겨 더 밝아집니다. -->
    <FrameRate>120</FrameRate>
    <!-- 센서 중앙에서 잘라낼 영역 크기(픽셀). 카메라 하드웨어 ROI 로 적용되어
         이 크기만 읽어옵니다(대역폭 절약 + 세그 모델 입력 640×640 과 동일).
         카메라가 요구하는 증분 단위로 내림 정렬되고 유효 범위로 제한됩니다.
         Width 또는 Height 를 0 으로 두면 크롭 없이 센서 전체를 사용합니다. -->
    <Width>640</Width>
    <Height>1280</Height>
    <!-- 크롭 창의 위치(%). 센서에서 움직일 수 있는 범위 기준이며 50 이 정중앙입니다.
         CenterX: 0=맨 왼쪽, 100=맨 오른쪽.
         CenterY: 0=맨 위,   100=맨 아래  → 50 보다 작게 하면 살짝 위로 올라갑니다.
         값이 없거나 0~100 범위를 벗어나면 기본값(50)을 사용합니다. -->
    <CenterX>45</CenterX>
    <CenterY>10</CenterY>
  </Camera>
  <Segmentation>
    <!-- 사용할 ONNX 세그멘테이션 모델 파일 이름. 실행 파일 옆 Models\ 폴더에서 찾습니다.
         이 이름의 .onnx 파일을 Models\ 에 넣어두면 됩니다.
         YoloDotNet 이 모델 버전을 자동 감지하므로 지원되는 YOLO 세그 모델
         (예: yolo26s-seg.onnx, yolov11s-seg.onnx)이면 그대로 동작합니다. -->
    <Model>yolo26s-seg.onnx</Model>
  </Segmentation>
</Config>
