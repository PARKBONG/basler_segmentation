<Window x:Class="BaslerLiveView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Basler Live View" Height="640" Width="960"
        Background="#1E1E1E" Closing="Window_Closing">
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Camera:" Foreground="#DDD" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CameraCombo" Width="320" VerticalAlignment="Center"
                          DisplayMemberPath="DisplayName"/>
                <Button x:Name="RefreshButton" Content="Refresh" Margin="6,0,0,0" Padding="10,4" Click="Refresh_Click"/>
                <Button x:Name="ConnectButton" Content="Connect" Margin="12,0,0,0" Padding="10,4" Click="Connect_Click"/>
                <Button x:Name="DisconnectButton" Content="Disconnect" Margin="6,0,0,0" Padding="10,4" Click="Disconnect_Click" IsEnabled="False"/>
                <Separator Margin="10,0" Width="1" Background="#555"/>
                <Button x:Name="StartButton" Content="▶ Start" Margin="0" Padding="10,4" Click="Start_Click" IsEnabled="False"/>
                <Button x:Name="StopButton" Content="■ Stop" Margin="6,0,0,0" Padding="10,4" Click="Stop_Click" IsEnabled="False"/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#007ACC" Padding="8,4">
            <DockPanel>
                <TextBlock x:Name="FpsText" DockPanel.Dock="Right" Foreground="White" Text=""/>
                <TextBlock x:Name="StatusText" Foreground="White" Text="Ready. Click Refresh to enumerate cameras."/>
            </DockPanel>
        </Border>

        <!-- Live image -->
        <Grid Background="Black">
            <Image x:Name="LiveImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
        </Grid>
    </DockPanel>
</Window>
