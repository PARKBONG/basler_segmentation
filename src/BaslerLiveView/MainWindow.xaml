<Window x:Class="BaslerLiveView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Basler Live View" Height="720" Width="900"
        Background="#1E1E1E" Closing="Window_Closing">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ConnectButton" Content="Connect" Padding="14,4" Click="Connect_Click"/>
                <Button x:Name="DisconnectButton" Content="Disconnect" Margin="6,0,0,0" Padding="12,4"
                        Click="Disconnect_Click" IsEnabled="False"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#007ACC" Padding="8,4">
            <DockPanel>
                <TextBlock x:Name="RateText" DockPanel.Dock="Right" Foreground="White" Text="" Margin="12,0,0,0"/>
                <TextBlock x:Name="StatusText" Foreground="White" Text="Ready."/>
            </DockPanel>
        </Border>

        <!-- Live image + vector overlay. The Viewbox scales both together, so the
             Canvas can use raw sensor pixel coordinates for boxes. -->
        <Grid Background="Black">
            <Viewbox Stretch="Uniform">
                <Grid>
                    <Image x:Name="LiveImage" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
                </Grid>
            </Viewbox>
            <TextBlock x:Name="NoSignalText" Text="NO SIGNAL" Foreground="#F48771" FontSize="28"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
