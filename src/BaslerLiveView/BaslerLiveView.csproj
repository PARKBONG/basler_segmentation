<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Basler.Pylon.dll is x64-only; force an x64 process so the native pylon libs load. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <AssemblyName>BaslerLiveView</AssemblyName>
    <RootNamespace>BaslerLiveView</RootNamespace>
  </PropertyGroup>

  <!-- Managed wrapper assembly shipped with the SDK checkout. -->
  <ItemGroup>
    <Reference Include="Basler.Pylon">
      <HintPath>..\..\include\pylon\Development\Assemblies\Basler.Pylon\net8.0\x64\Basler.Pylon.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!--
    YoloDotNet (built from source under include\YoloDotNet). The core library plus
    exactly ONE execution provider — DirectML for vendor-neutral GPU acceleration on
    Windows (DX12). To switch to NVIDIA CUDA/TensorRT later, replace the DirectML
    ProjectReference below with the Cuda one and install the CUDA 12.x + cuDNN 9.x
    runtime. Only one execution provider may be referenced per project.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\include\YoloDotNet\YoloDotNet\YoloDotNet.csproj" />
    <ProjectReference Include="..\..\include\YoloDotNet\YoloDotNet.ExecutionProvider.DirectML\YoloDotNet.ExecutionProvider.DirectML.csproj" />
  </ItemGroup>

  <!--
    ONNX segmentation model. It is NOT committed to this repo (large binary).
    The default model is sourced from the pinned YoloDotNet submodule's bundled
    assets and copied next to the executable on every build, so a fresh clone only
    needs:  git submodule update --init --recursive
    To use your own model, drop a *.onnx into Models\ (those are copied too, and a
    Models\yolov11s-seg.onnx there overrides the submodule default).
  -->
  <ItemGroup>
    <None Include="Models\**\*.onnx">
      <Link>Models\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="ProvideSegModelFromSubmodule" AfterTargets="Build">
    <PropertyGroup>
      <SegModelSource>$(MSBuildThisFileDirectory)..\..\include\YoloDotNet\test\assets\Models\yolov11s-seg.onnx</SegModelSource>
      <SegModelDest>$(OutDir)Models\yolov11s-seg.onnx</SegModelDest>
    </PropertyGroup>
    <Copy SourceFiles="$(SegModelSource)"
          DestinationFiles="$(SegModelDest)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(SegModelSource)') And !Exists('$(SegModelDest)')" />
    <Warning Text="Segmentation model missing: run 'git submodule update --init --recursive' to fetch YoloDotNet (bundles yolov11s-seg.onnx), or place your own in src\BaslerLiveView\Models\."
             Condition="!Exists('$(SegModelSource)') And !Exists('$(SegModelDest)')" />
  </Target>

  <!--
    pylon is NOT installed system-wide on this machine, so the native runtime
    (PylonBase / PylonC / transport-layer *_TL.dll producers) must sit next to
    the executable. Copy the whole Runtime\x64 tree into the output folder;
    the app base directory is always on the native DLL search path.
  -->
  <PropertyGroup>
    <PylonRuntimeDir>$(MSBuildThisFileDirectory)..\..\include\pylon\Runtime\x64</PylonRuntimeDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(PylonRuntimeDir)\**\*.*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
